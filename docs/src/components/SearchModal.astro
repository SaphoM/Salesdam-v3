---
import { Search, CornerDownLeft, ArrowUp, ArrowDown } from 'lucide-astro';
import { SEARCH_INDEX } from '../data/searchIndex.js';

/**
 * Site search. Opens with Cmd/Ctrl-K or by clicking the header search box.
 *
 * The index is serialised into the page at build time, so search works with no
 * network request and no search service. It is ~60 entries — small enough that
 * scoring every entry on each keystroke is imperceptible, so there is no
 * debounce or worker to reason about.
 */
---

<div id="search-modal" class="backdrop" hidden aria-hidden="true">
  <div
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-label"
  >
    <label id="search-label" class="sr-only" for="search-field">
      Search the documentation
    </label>

    <div class="input-row">
      <Search size={17} class="input-icon" aria-hidden="true" />
      <input
        id="search-field"
        type="text"
        class="input"
        placeholder="Search pages and endpoints…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-results"
        aria-autocomplete="list"
      />
      <kbd class="esc">Esc</kbd>
    </div>

    <ul id="search-results" class="results" role="listbox" aria-label="Search results"></ul>

    <p id="search-empty" class="empty" hidden>
      No matches. Try an endpoint path like <code>/records</code>, or a concept
      like <code>formula</code>.
    </p>

    <div class="footer">
      <span><ArrowUp size={11} /><ArrowDown size={11} /> to navigate</span>
      <span><CornerDownLeft size={11} /> to open</span>
      <span class="count">{SEARCH_INDEX.length} entries</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ INDEX: SEARCH_INDEX }}>
  (() => {
    const modal = document.getElementById('search-modal');
    const field = document.getElementById('search-field');
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    if (!modal || !field || !list) return;

    let results = [];
    let active = 0;
    let lastFocused = null;

    /**
     * Score one entry against the query.
     *
     * Ranked so that what you typed most precisely wins: an exact title match
     * beats a title prefix, which beats a substring, which beats a keyword or
     * description hit. Every query term must match something, so "formula date"
     * narrows rather than widening as it would with OR.
     */
    const score = (entry, terms) => {
      const title = entry.title.toLowerCase();
      const desc = (entry.description || '').toLowerCase();
      const keys = (entry.keywords || []).join(' ');
      const section = (entry.section || '').toLowerCase();
      const haystack = `${title} ${desc} ${keys} ${section} ${entry.path.toLowerCase()}`;

      let total = 0;
      for (const term of terms) {
        if (!haystack.includes(term)) return 0; // AND across terms
        if (title === term) total += 100;
        else if (title.startsWith(term)) total += 60;
        else if (title.includes(term)) total += 40;
        else if (keys.includes(term)) total += 25;
        else if (section.includes(term)) total += 15;
        else if (desc.includes(term)) total += 10;
        else total += 4; // path-only match
      }
      // Nudge pages above endpoints when scores tie: someone searching "records"
      // usually wants the guide before 11 individual operations.
      if (entry.kind === 'page') total += 3;
      return total;
    };

    const render = () => {
      list.innerHTML = results
        .map((r, i) => {
          const badge =
            r.kind === 'endpoint'
              ? `<span class="method method-${r.method.toLowerCase()}">${r.method}</span>`
              : `<span class="section">${r.section}</span>`;
          return `
            <li role="option" id="opt-${i}" aria-selected="${i === active}"
                class="result ${i === active ? 'active' : ''}">
              <a href="${r.path}" tabindex="-1">
                <span class="result-main">
                  ${badge}
                  <span class="result-title">${r.kind === 'endpoint' ? r.path.split('#')[0] + ' · ' + r.title.split(' ').slice(1).join(' ') : r.title}</span>
                </span>
                ${r.description ? `<span class="result-desc">${r.description}</span>` : ''}
              </a>
            </li>`;
        })
        .join('');

      if (empty) empty.hidden = results.length > 0 || field.value.trim() === '';
      field.setAttribute(
        'aria-activedescendant',
        results.length ? `opt-${active}` : '',
      );
    };

    const runSearch = () => {
      const terms = field.value.toLowerCase().split(/\s+/).filter(Boolean);
      if (terms.length === 0) {
        // Empty query shows a starting point rather than a blank pane.
        results = INDEX.filter((e) => e.kind === 'page').slice(0, 8);
      } else {
        results = INDEX.map((e) => ({ e, s: score(e, terms) }))
          .filter((x) => x.s > 0)
          .sort((a, b) => b.s - a.s)
          .slice(0, 12)
          .map((x) => x.e);
      }
      active = 0;
      render();
    };

    const open = () => {
      lastFocused = document.activeElement;
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      field.value = '';
      runSearch();
      field.focus();
    };

    const close = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Return focus where it was, so keyboard users aren't dumped at the top.
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
    };

    const move = (delta) => {
      if (!results.length) return;
      active = (active + delta + results.length) % results.length;
      render();
      list.querySelector('.result.active')?.scrollIntoView({ block: 'nearest' });
    };

    document.addEventListener('keydown', (e) => {
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      if (cmdK) {
        e.preventDefault();
        modal.hidden ? open() : close();
        return;
      }
      // `/` is a common docs shortcut, but must not hijack typing in a field.
      if (
        e.key === '/' &&
        modal.hidden &&
        !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '')
      ) {
        e.preventDefault();
        open();
        return;
      }
      if (modal.hidden) return;

      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const href = results[active]?.path;
        if (href) location.href = href;
      }
    });

    field.addEventListener('input', runSearch);

    // Clicking the scrim closes; clicking inside must not.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    // Any element with data-search-open triggers the modal (the header box, and
    // the mobile icon button).
    document.querySelectorAll('[data-search-open]').forEach((el) =>
      el.addEventListener('click', (e) => {
        e.preventDefault();
        open();
      }),
    );
  })();
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: var(--spacing-4);
    padding-top: 12vh;
  }

  .backdrop[hidden] {
    display: none;
  }

  .modal {
    width: 100%;
    max-width: 620px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: min(70vh, 560px);
  }

  .input-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    border-bottom: 1px solid var(--border-color);
    flex-shrink: 0;
  }

  .input-icon {
    color: var(--color-gray-400);
    flex-shrink: 0;
  }

  .input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-size: var(--font-size-base);
    font-family: var(--font-family);
    color: var(--color-gray-900);
    min-width: 0;
  }

  .input::placeholder {
    color: var(--color-gray-400);
  }

  .esc,
  .footer kbd {
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 2px 5px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-sm);
    color: var(--color-gray-500);
    background: var(--color-gray-50);
    flex-shrink: 0;
  }

  .results {
    list-style: none;
    margin: 0;
    padding: var(--spacing-2);
    overflow-y: auto;
    flex: 1;
  }

  .result a {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
  }

  .result.active a {
    background: var(--color-primary-light);
  }

  .result-main {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    min-width: 0;
  }

  .result-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-gray-800);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .result.active .result-title {
    color: var(--color-primary);
  }

  .result-desc {
    font-size: var(--font-size-xs);
    color: var(--color-gray-500);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .section {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-400);
    flex-shrink: 0;
  }

  .method {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: var(--font-weight-bold);
    padding: 2px 5px;
    border-radius: var(--border-radius-sm);
    flex-shrink: 0;
    min-width: 46px;
    text-align: center;
  }

  .method-get { color: var(--method-get); background: var(--method-get-bg); }
  .method-post { color: var(--method-post); background: var(--method-post-bg); }
  .method-put { color: var(--method-put); background: var(--method-put-bg); }
  .method-patch { color: var(--method-patch); background: var(--method-patch-bg); }
  .method-delete { color: var(--method-delete); background: var(--method-delete-bg); }

  .empty {
    padding: var(--spacing-6) var(--spacing-4);
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--color-gray-500);
    margin: 0;
  }

  .empty code {
    font-family: var(--font-mono);
    background: var(--color-gray-100);
    padding: 1px 5px;
    border-radius: var(--border-radius-sm);
  }

  .footer {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-2) var(--spacing-4);
    border-top: 1px solid var(--border-color);
    font-size: 11px;
    color: var(--color-gray-400);
    flex-shrink: 0;
  }

  .footer span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .count {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .backdrop {
      padding: 0;
      padding-top: 0;
    }

    .modal {
      max-width: none;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
      border: none;
    }

    /* Keyboard hints are meaningless on a touch device. */
    .footer span:not(.count) {
      display: none;
    }

    .esc {
      display: none;
    }
  }
</style>
