---
import { ChevronDown, X } from 'lucide-astro';
import { NAV, sectionFor } from '../data/navigation.js';

const currentUrl = Astro.url.pathname;

// Normalise so /api/overview/ and /api/overview both mark the same item active.
const current = currentUrl !== '/' ? currentUrl.replace(/\/$/, '') : '/';
const openSection = sectionFor(current);

const isActive = (path) => (path !== '/' ? path.replace(/\/$/, '') : '/') === current;
---

<!-- On small screens this becomes an off-canvas drawer; the scrim and the body
     class that drives it are owned by MainLayout. -->
<aside class="sidebar" id="docs-sidebar">
  <div class="drawer-head">
    <span class="drawer-title">Documentation</span>
    <button class="drawer-close" data-nav-close aria-label="Close navigation">
      <X size={18} />
    </button>
  </div>

  <nav class="nav" aria-label="Documentation">
    {NAV.map((section) => {
      // A section starts open when it contains the current page, so the reader
      // always sees where they are without hunting. Everything else starts shut
      // so the whole tree is scannable — 7 sections fully expanded is 32 links.
      const open = openSection === section.title;
      return (
        <details class="section" open={open}>
          <summary class="section-summary">
            <span class="section-title">{section.title}</span>
            <ChevronDown size={14} class="chevron" aria-hidden="true" />
          </summary>
          <ul class="items">
            {section.items.map((item) => (
              <li>
                <a
                  href={item.path}
                  class:list={['item', { active: isActive(item.path) }]}
                  aria-current={isActive(item.path) ? 'page' : undefined}
                  title={item.description}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      );
    })}
  </nav>
</aside>

<style>
  .sidebar {
    width: var(--docs-sidebar-width);
    flex-shrink: 0;
    background: var(--surface);
    border-right: 1px solid var(--border-color);
    padding: var(--spacing-4) 0 var(--spacing-8);
    position: sticky;
    top: var(--docs-header-height);
    height: calc(100vh - var(--docs-header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-gray-300) transparent;
  }

  .sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: var(--color-gray-300);
    border-radius: 3px;
  }

  .sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  /* Drawer chrome — hidden on desktop where the sidebar is permanent. */
  .drawer-head {
    display: none;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--spacing-4) var(--spacing-3);
    margin-bottom: var(--spacing-2);
    border-bottom: 1px solid var(--border-color);
  }

  .drawer-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-gray-800);
  }

  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    background: none;
    border-radius: var(--border-radius);
    color: var(--color-gray-500);
    cursor: pointer;
  }

  .drawer-close:hover {
    background: var(--color-gray-100);
    color: var(--color-gray-800);
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* ── Sections ───────────────────────────────────────────────────────────── */
  .section {
    padding: 0 var(--spacing-3);
  }

  .section-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-2);
    cursor: pointer;
    border-radius: var(--border-radius);
    list-style: none;
    user-select: none;
  }

  /* Suppress the native disclosure triangle in both engines. */
  .section-summary::-webkit-details-marker {
    display: none;
  }

  .section-summary::marker {
    content: '';
  }

  .section-summary:hover {
    background: var(--color-gray-50);
  }

  .section-summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .section-title {
    font-size: 11px;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray-500);
  }

  .chevron {
    color: var(--color-gray-400);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .section[open] .chevron {
    transform: rotate(180deg);
  }

  /* ── Items ──────────────────────────────────────────────────────────────── */
  .items {
    list-style: none;
    margin: 2px 0 var(--spacing-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    /* The rail the active marker sits on, so items read as a group. */
    border-left: 1px solid var(--border-color);
    margin-left: var(--spacing-2);
  }

  .item {
    display: block;
    padding: 6px var(--spacing-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--color-gray-600);
    text-decoration: none;
    font-size: var(--font-size-sm);
    line-height: 1.4;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background var(--transition-fast);
  }

  .item:hover {
    color: var(--color-gray-900);
    background: var(--color-gray-50);
  }

  .item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .item.active {
    color: var(--color-primary);
    border-left-color: var(--color-primary);
    background: var(--color-primary-light);
    font-weight: var(--font-weight-semibold);
  }

  /* ── Drawer, below 1024px ───────────────────────────────────────────────── */
  /* The previous sidebar was `display: none` here, which left the site with no
     navigation at all on a phone — every page was a dead end. */
  @media (max-width: 1024px) {
    .sidebar {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      z-index: var(--z-drawer);
      width: min(86vw, var(--docs-sidebar-width));
      padding-top: var(--spacing-4);
      transform: translateX(-100%);
      transition: transform var(--transition-base);
      box-shadow: var(--shadow-xl);
    }

    :global(body.nav-open) .sidebar {
      transform: translateX(0);
    }

    .drawer-head {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar {
      transition: none;
    }
  }
</style>
