---
import MainLayout from '../layouts/MainLayout.astro';
import {
  Rocket,
  UserPlus,
  Database,
  Plug,
  Building2,
  Code2,
  User,
  Settings,
  Terminal,
} from 'lucide-astro';

// lucide-astro renders to inline SVG at build time, so these cost no client JS.
// They replace the emoji that used to sit here: emoji render differently on every
// platform, don't inherit colour, and are what broke when the file's encoding was
// mangled — an SVG has none of those problems.
const QUICK_LINKS = [
  { href: '/getting-started/quick-start',            Icon: Rocket,    title: 'Quick Start',     blurb: 'Get up and running in 5 minutes' },
  { href: '/user-guide/registration',                Icon: UserPlus,  title: 'Registration',    blurb: 'Learn about user registration and setup' },
  { href: '/data-model/objects',                     Icon: Database,  title: 'Data Model',      blurb: 'Understand objects, fields, and relationships' },
  { href: '/api/reference',                          Icon: Plug,      title: 'API Reference',   blurb: 'Explore every endpoint, and send real requests' },
  { href: '/architecture/system-architecture',       Icon: Building2, title: 'Architecture',    blurb: 'Dive into system architecture' },
  { href: '/developer/setup',                        Icon: Code2,     title: 'Developer Guide', blurb: 'Setup and development instructions' },
];
---

<MainLayout title="Salesdam Documentation" description="Complete documentation for the Salesdam CRM platform">
  <div class="hero-section">
    <h1>Salesdam CRM Documentation</h1>
    <p class="subtitle">Complete guide to building, deploying, and managing the Salesdam Customer Relationship Management system</p>

    <div class="quick-links">
      {QUICK_LINKS.map(({ href, Icon, title, blurb }) => (
        <a href={href} class="quick-link-card">
          <span class="icon"><Icon size={22} aria-hidden="true" /></span>
          <h3>{title}</h3>
          <p>{blurb}</p>
        </a>
      ))}
    </div>
  </div>

  <div class="features-section">
    <h2>Key Features</h2>
    <div class="features-grid">
      <div class="feature">
        <h3>Multi-Tenant Architecture</h3>
        <p>Support for multiple organizations with complete data isolation and customizable workspaces</p>
      </div>
      <div class="feature">
        <h3>Flexible Object Model</h3>
        <p>Create custom CRM objects with configurable fields, layouts, and relationships</p>
      </div>
      <div class="feature">
        <h3>Role-Based Access Control</h3>
        <p>Granular permissions at object and field level with predefined and custom roles</p>
      </div>
      <div class="feature">
        <h3>Rich Dashboard & Reports</h3>
        <p>Create custom dashboards and reports with drag-and-drop interface</p>
      </div>
      <div class="feature">
        <h3>Workflow Automation</h3>
        <p>Automate business processes with rules engine and workflow builder</p>
      </div>
      <div class="feature">
        <h3>RESTful API</h3>
        <p>Complete REST API for programmatic access to all CRM data and operations</p>
      </div>
    </div>
  </div>

  <div class="tech-stack-section">
    <h2>Technology Stack</h2>
    <div class="tech-grid">
      <div class="tech-item">
        <strong>Frontend</strong>
        <p>React 18+, Vite, React Query, React Router</p>
      </div>
      <div class="tech-item">
        <strong>Backend</strong>
        <p>Node.js, Express.js, MongoDB, Mongoose</p>
      </div>
      <div class="tech-item">
        <strong>Authentication</strong>
        <p>JWT, bcrypt, Email Verification, 2FA Ready</p>
      </div>
      <div class="tech-item">
        <strong>DevOps</strong>
        <p>Docker, Docker Compose, CI/CD Ready</p>
      </div>
    </div>
  </div>

  <div class="getting-started-section">
    <h2>Getting Started</h2>
    <p>Start exploring the documentation based on your role:</p>

    <div class="roles-grid">
      <div class="role-card">
        <h3><User size={17} aria-hidden="true" /> End Users</h3>
        <ul>
          <li><a href="/user-guide/registration">Registration &amp; onboarding</a></li>
          <li><a href="/user-guide/authentication">Signing in</a></li>
          <li><a href="/user-guide/password-reset">Resetting a password</a></li>
          <li><a href="/user-guide/roles-permissions">What your role can do</a></li>
        </ul>
      </div>

      <div class="role-card">
        <h3><Settings size={17} aria-hidden="true" /> Administrators</h3>
        <ul>
          <li><a href="/user-guide/roles-permissions">Roles &amp; permissions</a></li>
          <li><a href="/data-model/objects">Creating custom objects</a></li>
          <li><a href="/concepts/validation-rules">Validation rules</a></li>
          <li><a href="/api/authentication">API keys</a></li>
        </ul>
      </div>

      <div class="role-card">
        <h3><Terminal size={17} aria-hidden="true" /> Developers</h3>
        <ul>
          <li><a href="/getting-started/installation">Installation</a></li>
          <li><a href="/api/reference">Endpoint explorer</a></li>
          <li><a href="/concepts/formula-fields">Formula fields</a></li>
          <li><a href="/developer/backend">Backend development</a></li>
        </ul>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .hero-section {
    margin-bottom: 60px;
  }

  .subtitle {
    font-size: 18px;
    color: var(--color-gray-500);
    margin-bottom: 40px;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 40px 0;
  }

  .quick-link-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    text-align: center;
    transition: all 0.3s;
    color: var(--color-gray-800);
    text-decoration: none;
  }

  .quick-link-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(36, 76, 100, 0.15);
    transform: translateY(-2px);
    color: var(--color-primary);
  }

  /* A tinted chip behind the icon, so the cards read as a set. The SVG takes its
     colour from `currentColor`, which is what lets it turn primary on hover
     along with the rest of the card — something the emoji it replaced could
     never do. */
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--spacing-3);
    border-radius: var(--border-radius-md);
    background: var(--color-primary-light);
    color: var(--color-primary);
    transition:
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .quick-link-card:hover .icon {
    background: var(--color-primary);
    color: #ffffff;
  }

  .quick-link-card h3 {
    margin: 8px 0;
    font-size: 16px;
  }

  .quick-link-card p {
    font-size: 13px;
    color: var(--color-gray-500);
    margin: 0;
  }

  .features-section {
    margin: 60px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .feature {
    background: var(--surface);
    padding: 20px;
    border-radius: 8px;
    border-left: 4px solid var(--color-primary);
  }

  .feature h3 {
    margin-top: 0;
    margin-bottom: 10px;
  }

  .feature p {
    margin: 0;
    color: var(--color-gray-500);
    font-size: 14px;
  }

  .tech-stack-section {
    margin: 60px 0;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .tech-item {
    background: var(--surface);
    padding: 20px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  .tech-item strong {
    display: block;
    margin-bottom: 8px;
    color: var(--color-primary);
  }

  .tech-item p {
    margin: 0;
    font-size: 13px;
    color: var(--color-gray-500);
  }

  .getting-started-section {
    margin: 60px 0;
  }

  .roles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .role-card {
    background: var(--surface);
    padding: 24px;
    border-radius: 8px;
    border: 1px solid var(--border-color);
  }

  /* Flex so the inline icon sits on the text's optical centre rather than its
     baseline, which is where an inline SVG lands by default. */
  .role-card h3 {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    margin-top: 0;
    margin-bottom: var(--spacing-4);
    color: var(--color-primary);
  }

  .role-card h3 :global(svg) {
    flex-shrink: 0;
  }

  .role-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .role-card li {
    margin-bottom: 12px;
  }

  .role-card a {
    color: var(--color-primary);
    font-size: 14px;
  }

  .role-card a:hover {
    color: var(--color-primary-hover);
  }

  @media (max-width: 768px) {
    .quick-links {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .tech-grid {
      grid-template-columns: 1fr;
    }

    .roles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
