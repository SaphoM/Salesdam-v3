          'Parser supports: arithmetic (+,-,*,/), comparison (==,!=,>,>=,<,<=), logic (&&,||,!), string concatenation',
          'Built-in functions: LENGTH, ISBLANK, ISNULL, CONTAINS, REGEX, TODAY, NOW, UPPER, LOWER, TRIM, ABS, ROUND, YEAR, MONTH, DAY',
          'Field API names injected as variables at evaluation time',
          'Expressions validated via POST /api/records/validate-formula before saving',
          'FormulaEditor in UI provides Fields, Functions, Operators, and Examples panels with click-to-insert',
        ],
        tests: [
          {
            id: 'TC-071-01',
            type: 'positive',
            desc: 'POST /validate-formula with "LENGTH(phone) == 10" → { valid: true }',
          },
          {
            id: 'TC-071-02',
            type: 'negative',
            desc: 'POST /validate-formula with "LENGTH(phone ==" → { valid: false, error: "Missing closing parenthesis" }',
          },
          {
            id: 'TC-071-03',
            type: 'positive',
            desc: 'Validation rule "close_date > start_date" → saves record with valid dates, rejects inverted dates',
          },
        ],
      },
    ],
  },
];

/* (⚠️ Keep your full EPICS array here exactly as-is) */

const totalStories = EPICS.reduce((s, e) => s + e.stories.length, 0);
const totalTests = EPICS.reduce(
  (s, e) => e.stories.reduce((ss, st) => ss + st.tests.length, 0) + s,
  0,
);
---

<DevLayout
  title="User Stories"
  description="Build backlog, acceptance criteria, and test cases for the CRM platform"
>
  <div class="page">
    <div class="header">
      <div>
        <h1 class="title">User Stories & Test Cases</h1>
        <p class="subtitle">Complete backlog in sequential build order.</p>
      </div>

      <div class="stats">
        <div class="stat">
          <span class="statNum">{EPICS.length}</span>
          <span class="statLabel">Epics</span>
        </div>
        <div class="stat">
          <span class="statNum">{totalStories}</span>
          <span class="statLabel">User Stories</span>
        </div>
        <div class="stat">
          <span class="statNum">{totalTests}</span>
          <span class="statLabel">Test Cases</span>
        </div>
      </div>
    </div>

    <!-- Legend -->
    <div class="legend">
      <span class="legendLabel">Test types:</span>
      {
        Object.entries(TEST_COLORS).map(([type, cfg]) => (
          <span
            style={`background:${cfg.bg};color:${cfg.color}`}
            class="legendBadge"
          >
            {cfg.label}
          </span>
        ))
      }
    </div>

    {
      EPICS.map((epic) => (
        <div class="epic" data-epic>
          <div class="epicHeader" style={`border-left:4px solid ${epic.color}`}>
            <div class="epicLeft">
              <epic.icon size={18} color={epic.color} />
              <div>
                <div class="epicTitle">
                  <span class="epicId">{epic.id}</span>
                  {epic.title}
                </div>
                <div class="epicMeta">{epic.stories.length} stories</div>
              </div>
            </div>
            <ChevronDown class="toggleIcon" size={16} />
          </div>

          <div class="epicBody">
            {epic.stories.map((story) => (
              <div class="story" data-story>
                <div class="storyHeader">
                  <div class="storyMeta">
                    <span class="storyId">{story.id}</span>
                    <span>{story.title}</span>
                  </div>
                  <ChevronRight class="toggleIcon" size={14} />
                </div>

                <div class="storyNarrative">
                  <strong>As a {story.role}</strong>, I want to {story.goal}, so
                  that {story.benefit}.
                </div>

                <div class="storyBody">
                  <h5 class="sectionLabel">
                    <CheckCircle size={13} /> Acceptance Criteria
                  </h5>
                  <ul>
                    {story.acceptance.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>

                  <h5 class="sectionLabel">
                    <TestTube size={13} /> Test Cases
                  </h5>
                  <table class="testTable">
                    <thead>
                      <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Description</th>
                      </tr>
                    </thead>
                    <tbody>
                      {story.tests.map((t) => (
                        <tr>
                          <td>
                            <code>{t.id}</code>
                          </td>
                          <td>
                            <span
                              class="badge"
                              style={`background:${TEST_COLORS[t.type].bg};color:${TEST_COLORS[t.type].color}`}
                            >
                              {TEST_COLORS[t.type].label}
                            </span>
                          </td>
                          <td>{t.desc}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <!-- ── INTERACTIVITY ───────────────────────────────────────── -->
  <script>
    document.querySelectorAll('[data-epic]').forEach((epic) => {
      const header = epic.querySelector('.epicHeader');
      const body = epic.querySelector('.epicBody');

      header.addEventListener('click', () => {
        body.classList.toggle('open');
      });
    });

    document.querySelectorAll('[data-story]').forEach((story) => {
      const header = story.querySelector('.storyHeader');
      const body = story.querySelector('.storyBody');

      header.addEventListener('click', () => {
        body.classList.toggle('open');
      });
    });
  </script>

  <!-- ── STYLES ─────────────────────────────────────────────── -->
  <style>
    .page {
      padding: 24px;
      font-family: Arial;
    }
    .header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .title {
      font-size: 28px;
    }
    .subtitle {
      color: #666;
    }

    .stats {
      display: flex;
      gap: 20px;
    }
    .statNum {
      font-size: 20px;
      font-weight: bold;
      display: block;
    }

    .legend {
      margin-bottom: 16px;
    }
    .legendBadge {
      padding: 4px 8px;
      border-radius: 10px;
      margin-right: 6px;
      font-size: 12px;
      font-weight: bold;
    }

    .epic {
      border: 1px solid #eee;
      margin-bottom: 16px;
      border-radius: 8px;
    }
    .epicHeader {
      padding: 12px;
      display: flex;
      justify-content: space-between;
      cursor: pointer;
      background: #fafafa;
    }

    .epicBody {
      display: none;
      padding: 12px;
    }
    .epicBody.open {
      display: block;
    }

    .story {
      border-top: 1px solid #eee;
      padding: 10px;
    }
    .storyHeader {
      display: flex;
      justify-content: space-between;
      cursor: pointer;
    }

    .storyBody {
      display: none;
      margin-top: 10px;
    }
    .storyBody.open {
      display: block;
    }

    .badge {
      padding: 2px 6px;
      border-radius: 10px;
      font-size: 10px;
      font-weight: bold;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    th,
    td {
      border: 1px solid #ddd;
      padding: 6px;
      text-align: left;
    }

    .epicLeft {
      display: flex;
      gap: 10px;
      align-items: center;
    }
  </style>
</DevLayout>
