---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocsSidebar from '../components/DocsSidebar.astro';

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />

  <div class="docs-container">
    <DocsSidebar currentPath={Astro.url.pathname} isDev={true} />

    <main class="docs-content">
      <div class="internal-badge">Internal Documentation</div>
      <div class="docs-inner">
        <slot />
      </div>
    </main>
  </div>

  <Footer />
</BaseLayout>

<style>
  .docs-container {
    display: flex;
    min-height: calc(100vh - 140px);
    max-width: 1400px;
    margin: 0 auto;
    padding-top: 80px;
  }

  .docs-content {
    flex: 1;
    padding: 40px;
    background: white;
    margin: 24px 24px 24px 0;
    border-radius: 12px;
    box-shadow: var(--shadow);
    position: relative;
  }

  .internal-badge {
    display: inline-block;
    background: #f59e0b;
    color: white;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
  }

  .docs-inner {
    max-width: 900px;
  }

  .docs-inner :global(h1) {
    font-size: 2.5rem;
    margin-bottom: 24px;
    color: var(--text);
  }

  .docs-inner :global(h2) {
    font-size: 2rem;
    margin-top: 48px;
    margin-bottom: 16px;
    color: var(--text);
    border-bottom: 2px solid var(--border);
    padding-bottom: 8px;
  }

  .docs-inner :global(h3) {
    font-size: 1.5rem;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--text);
  }

  .docs-inner :global(h4) {
    font-size: 1.25rem;
    margin-top: 24px;
    margin-bottom: 8px;
    color: var(--text);
  }

  .docs-inner :global(p) {
    margin-bottom: 16px;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .docs-inner :global(ul), .docs-inner :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
    color: var(--text-secondary);
  }

  .docs-inner :global(li) {
    margin-bottom: 8px;
  }

  .docs-inner :global(code) {
    background: var(--bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
    color: var(--primary);
  }

  .docs-inner :global(pre) {
    background: var(--text);
    color: white;
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 24px;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .docs-inner :global(pre code) {
    background: transparent;
    color: white;
    padding: 0;
  }

  .docs-inner :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
  }

  .docs-inner :global(th) {
    background: var(--bg);
    padding: 12px;
    text-align: left;
    border: 1px solid var(--border);
    font-weight: 600;
  }

  .docs-inner :global(td) {
    padding: 12px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  @media (max-width: 968px) {
    .docs-container {
      flex-direction: column;
    }

    .docs-content {
      margin: 24px;
    }
  }

  @media (max-width: 768px) {
    .docs-content {
      padding: 24px;
    }

    .docs-inner :global(h1) {
      font-size: 2rem;
    }

    .docs-inner :global(h2) {
      font-size: 1.5rem;
    }
  }
</style>
