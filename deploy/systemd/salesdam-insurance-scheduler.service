# Salesdam Insurance Workspace - Production Scheduler
# Install: sudo cp salesdam-insurance-scheduler.service /etc/systemd/system/
# Enable: sudo systemctl enable salesdam-insurance-scheduler.timer
# Start: sudo systemctl start salesdam-insurance-scheduler.timer

[Unit]
Description=Salesdam Insurance Workspace - Scheduled Jobs
Documentation=https://salesdam.example.com/docs/scheduler
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=oneshot
WorkingDirectory=/opt/salesdam/backend
ExecStart=/usr/bin/node scripts/run-insurance-scheduler.js
User=salesdam
Group=salesdam
Environment=NODE_ENV=production
EnvironmentFile=-/etc/salesdam/environment
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salesdam-insurance-scheduler
TimeoutSec=300

# Resource limits
MemoryMax=512M
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/salesdam/backend/logs /opt/salesdam/backend/uploads

[Install]
WantedBy=multi-user.target