# Salesdam Insurance Workspace - Auto Lapse Evaluation
# Runs daily at 4:00 AM to evaluate policy arrears and auto-lapse eligible policies

[Unit]
Description=Salesdam Insurance Workspace - Auto Lapse Evaluation
Documentation=https://salesdam.example.com/docs/auto-lapse
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=oneshot
WorkingDirectory=/opt/salesdam/backend
ExecStart=/usr/bin/node scripts/run-auto-lapse.js
User=salesdam
Group=salesdam
Environment=NODE_ENV=production
EnvironmentFile=-/etc/salesdam/environment
StandardOutput=journal
StandardError=journal
SyslogIdentifier=salesdam-auto-lapse
TimeoutSec=300

MemoryMax=256M
CPUQuota=100%

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/salesdam/backend/logs /opt/salesdam/backend/uploads

[Install]
WantedBy=multi-user.target