# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/etendersDb

# Access tokens allowed to call the API (comma separated, no spaces)
API_ACCESS_TOKENS=13dbbc7cd40d9345509b7c7beacfcdb7c7323d210ac270724cfd90f9b1bcd83f

# eTenders source
ETENDERS_BASE_URL=https://www.etenders.gov.za/Home/PaginatedTenderOpportunities
ETENDERS_STATUS=1
FETCH_PAGE_SIZE=100
ETENDERS_REQUEST_TIMEOUT_MS=30000

# Cron schedules (cron syntax, server timezone). Defaults = 06:00 and 18:00 daily.
FETCH_CRON_MORNING=0 6 * * *
FETCH_CRON_EVENING=0 18 * * *

# Set to "true" to run a fetch immediately on server start (useful for local testing)
RUN_FETCH_ON_STARTUP=false

# Rate limiting - applies to all /api/* routes, keyed by access token (falls back to IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stricter limit for the manual sync endpoint (POST /api/admin/sync)
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=5
